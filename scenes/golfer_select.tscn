; ============================================================
; golfer_select.tscn
; Shows after title screen, before course select.
; Two modes: profile list (if profiles exist) or create form.
; ============================================================
[gd_scene load_steps=2 format=3 uid="uid://owg_golfer_select"]

[ext_resource type="Script" path="res://golfer_select.gd" id="1_script"]

[node name="GolferSelect" type="Control"]
layout_mode = 3
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

; ── Dark green background ─────────────────────────────────
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.07, 0.04, 1)

; ── Header bar ───────────────────────────────────────────
[node name="Header" type="Label" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 0.09
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.95, 0.88, 0.4, 1)
text = "⛳  Open World Golf — Golfer Select"
horizontal_alignment = 1
vertical_alignment = 1

; ── Back to title button ─────────────────────────────────
[node name="BackButton" type="Button" parent="."]
layout_mode = 1
anchor_top = 0.01
anchor_bottom = 0.08
anchor_right = 0.10
offset_left = 8
offset_right = -4
grow_vertical = 2
theme_override_font_sizes/font_size = 14
text = "◀  Title"

; =============================================================
; LIST PANEL — shown when profiles exist
; =============================================================
[node name="ListPanel" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.20
anchor_top = 0.10
anchor_right = 0.80
anchor_bottom = 0.92
offset_top = 8
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="ListTitle" type="Label" parent="ListPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.75, 0.90, 0.65, 1)
text = "Select Golfer"
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="ListPanel"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 200)

[node name="GolferList" type="VBoxContainer" parent="ListPanel/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="ListButtons" type="HBoxContainer" parent="ListPanel"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="BtnNewGolfer" type="Button" parent="ListPanel/ListButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(160, 48)
theme_override_font_sizes/font_size = 16
text = "＋  New Golfer"

[node name="BtnPlay" type="Button" parent="ListPanel/ListButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(200, 48)
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.95, 1.0, 0.6, 1)
text = "▶  Play as …"
disabled = true

; =============================================================
; CREATE FORM — shown when no profiles or New Golfer pressed
; =============================================================
[node name="CreateForm" type="VBoxContainer" parent="."]
visible = false
layout_mode = 1
anchor_left = 0.25
anchor_top = 0.12
anchor_right = 0.75
anchor_bottom = 0.90
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 22

[node name="FormTitle" type="Label" parent="CreateForm"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.75, 0.90, 0.65, 1)
text = "Create New Golfer"
horizontal_alignment = 1

; Name row
[node name="NameRow" type="VBoxContainer" parent="CreateForm"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="NameLabel" type="Label" parent="CreateForm/NameRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.70, 0.82, 0.65, 1)
text = "Name"

[node name="NameInput" type="LineEdit" parent="CreateForm/NameRow"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
theme_override_font_sizes/font_size = 18
placeholder_text = "Enter your name…"
max_length = 24

; Gender row
[node name="GenderRow" type="VBoxContainer" parent="CreateForm"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="GenderLabel" type="Label" parent="CreateForm/GenderRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.70, 0.82, 0.65, 1)
text = "Gender"

[node name="GenderButtons" type="HBoxContainer" parent="CreateForm/GenderRow"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BtnMale" type="Button" parent="CreateForm/GenderRow/GenderButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(110, 44)
theme_override_font_sizes/font_size = 16
text = "♂  Male"
toggle_mode = true
button_pressed = true

[node name="BtnFemale" type="Button" parent="CreateForm/GenderRow/GenderButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(110, 44)
theme_override_font_sizes/font_size = 16
text = "♀  Female"
toggle_mode = true

; Handedness row
[node name="HandRow" type="VBoxContainer" parent="CreateForm"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HandLabel" type="Label" parent="CreateForm/HandRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.70, 0.82, 0.65, 1)
text = "Handedness"

[node name="HandButtons" type="HBoxContainer" parent="CreateForm/HandRow"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BtnRight" type="Button" parent="CreateForm/HandRow/HandButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(110, 44)
theme_override_font_sizes/font_size = 16
text = "Right"
toggle_mode = true
button_pressed = true

[node name="BtnLeft" type="Button" parent="CreateForm/HandRow/HandButtons"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(110, 44)
theme_override_font_sizes/font_size = 16
text = "Left"
toggle_mode = true

; Validation hint
[node name="ValidationHint" type="Label" parent="CreateForm"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.9, 0.4, 0.3, 1)
text = ""
horizontal_alignment = 1

; Form action buttons
[node name="FormActions" type="HBoxContainer" parent="CreateForm"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="BtnCancel" type="Button" parent="CreateForm/FormActions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(120, 44)
theme_override_font_sizes/font_size = 15
text = "Cancel"

[node name="BtnCreate" type="Button" parent="CreateForm/FormActions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(200, 44)
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.95, 1.0, 0.6, 1)
text = "✔  Create & Play"

; ── Hint bar ─────────────────────────────────────────────
[node name="HintBar" type="Label" parent="."]
layout_mode = 1
anchor_top = 0.94
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.4, 0.55, 0.4, 0.75)
text = "↑ ↓ to select  |  Enter to play  |  ESC = title"
horizontal_alignment = 1
vertical_alignment = 1
